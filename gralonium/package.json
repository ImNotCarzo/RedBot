{
  "name": "gralonium",
  "description": "i know.",
  "version": "0.2.0",
  "license": "MIT",
  "author": "carzo",

  "type": "commonjs",

  "main": "./lib/main.js",
  "types": "./lib/main.d.ts",

  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "require": "./lib/main.js",
      "import": "./lib/main.js",
      "default": "./lib/main.js"
    },
    "./experiments": {
      "types": "./lib/experiments.d.ts",
      "require": "./lib/experiments.js",
      "import": "./lib/experiments.js",
      "default": "./lib/experiments.js"
    }
  },

  "files": [
    "lib/**/*"
  ],

  "sideEffects": false,

  "scripts": {
    "build": "node -e \"const fs=require('fs');const cp=require('child_process');if(!fs.existsSync('tsconfig.json')||!fs.existsSync('src')){console.log('Skipping build: tsconfig.json/src not found');process.exit(0)}cp.execSync('tsc -p tsconfig.json && tsc-alias -p tsconfig.json',{stdio:'inherit',shell:true})\"",
    "watch": "tsc -w -p tsconfig.json",
    "dev": "npm run watch",
    "clean": "rimraf lib",
    "prepublishOnly": "npm run build"
  },

  "keywords": [
    "bot"
  ],

  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },

  "engines": {
    "node": ">=18.0.0"
  },

  "peerDependencies": {
    "discord.js": "^14.0.0"
  },

  "dependencies": {
    "@sapphire/shapeshift": "^3.9.7",
    "tslib": "^2.6.2"
  },

  "devDependencies": {
    "typescript": "^5.4.5",
    "tsc-alias": "^1.8.8",
    "rimraf": "^5.0.5"
  }
}
