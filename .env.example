# ─── Required ──────────────────────────────────────────────────────────────────
TOKEN=your_discord_bot_token_here
MONGO=mongodb+srv://user:password@cluster.mongodb.net/redbot
CLIENT_ID=123456789012345678

# ─── AI keys ───────────────────────────────────────────────────────────────────
# At least one Gemini key is needed for the /ask command and AI follow-ups.
GEMINI=AIza...
GEMINI2=AIza...          # Optional second key for automatic rotation on rate-limit
OPENROUTER=sk-or-...      # Optional OpenRouter key

# Groq (used by commands that call the Groq SDK)
GROQ=gsk_...

# ─── Optional ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info            # error | warn | info | debug  (default: info)
NODE_ENV=production       # development | production     (default: development)

# Runtime resiliency tuning (Discord + DB)
READY_API_TIMEOUT_MS=45000
READY_RETRY_ATTEMPTS=5
READY_RETRY_BASE_DELAY_MS=1500
READY_SYNC_INITIAL_DELAY_MS=5000
READY_SYNC_INTERVAL_MS=900000
ROLE_CONNECTION_TIMEOUT_MS=15000
GATEWAY_RECOVERY_GRACE_MS=120000
PREFIX_QUERY_TIMEOUT_MS=2500
